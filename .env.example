# Copy to .env and set generated local secrets. Do not commit .env.
ENGINE_API_KEY=
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Host-based development defaults; Compose overrides these.
ENGINE_API_URL=http://127.0.0.1:8001
ENGINE_DATABASE_URL=sqlite:///engine.sqlite3
ENGINE_MODEL_PATH=media/models/portable.joblib
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
THREADS_ACCESS_TOKEN=
